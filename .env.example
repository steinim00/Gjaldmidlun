# Visa Developer Center credentials (Credentials -> Two-Way SSL)
# The Foreign Exchange Rates API uses mutual TLS (Two-Way SSL), not X-Pay
# Token: submit a CSR in the Project Console, then Visa issues a client
# certificate plus a username/password. Never commit the actual cert/key
# files (they belong under certs/, which is gitignored).
VISA_USER_ID=your-visa-two-way-ssl-username
VISA_PASSWORD=your-visa-two-way-ssl-password
VISA_CLIENT_CERT_PATH=certs/visa_cert.pem
VISA_CLIENT_KEY_PATH=certs/visa_private_key.pem

# Sandbox by default; switch to the production URL once you have live credentials.
VISA_BASE_URL=https://sandbox.api.visa.com
